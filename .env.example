# ─────────────────────────────────────────────────────────────────
#  ZAGADAT CAPITAL — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Flask secret key — change this to a long random string in production
SECRET_KEY=zagadat-capital-change-this-in-production

# Email configuration (for account approval notifications)
# Example: Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@zagadatcapital.com

# Note: For Gmail, enable 2FA and generate an App Password
# Go to: Google Account → Security → App Passwords
